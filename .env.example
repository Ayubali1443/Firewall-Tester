# Cloudflare Zero Trust credentials (used ONLY by worker/setup-worker.ps1 to upload Worker Secrets;
# NEVER compiled into SentinelGateAI-Setup.exe when using Worker Relay mode)
ACCOUNT_ID="your-cloudflare-account-id"
API_TOKEN="your-scoped-cloudflare-zero-trust-api-token"

# Zero-Token Worker Relay configuration (sealed into SentinelGateAI-Setup.exe)
WORKER_URL="https://sentinelgate-relay.your-subdomain.workers.dev"
RELAY_CLIENT_SECRET="replace-with-strong-random-relay-secret"
